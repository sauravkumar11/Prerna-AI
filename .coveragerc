[run]
branch = True
source = backend
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    setup.py
    */site-packages/*

[report]
precision = 2
show_missing = True
skip_covered = False
sort = Cover

# Exclude specific code patterns from coverage requirements
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abstract
    class .*\(Protocol\):
    if sys.version_info

[html]
directory = backend/htmlcov

[xml]
output = backend/coverage.xml

[paths]
source =
    backend/
    */backend/
