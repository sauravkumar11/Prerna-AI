# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_first_key_here

# ── Optional controlled failover keys (opt-in) ───────────────────────────────
# Default behavior uses only GEMINI_API_KEY.
# Enable failover only for operational resilience, not quota circumvention.
# You must comply with Google/Gemini terms and usage limits.
# ENABLE_GEMINI_KEY_FAILOVER=true
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# ── Optional overrides ─────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_CHAT_TEMPERATURE=0.9
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=DEBUG
